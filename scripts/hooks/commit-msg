#!/usr/bin/env bash
# commit-msg hook: rejects attribution trailers, non-ASCII text, bad subjects,
# a wrong author, and any pattern listed in ~/.harness/banned-words.
set -u
msg="$1"
fail() { printf 'commit-msg: %s\nFix: %s\n' "$1" "$2" >&2; exit 1; }

body=$(grep -v '^#' "$msg")
subject=$(printf '%s\n' "$body" | sed -n '1p')

if printf '%s\n' "$body" | grep -Eiq '^(co-authored-by|signed-off-by|generated-by):'; then
  fail "attribution trailer found" "remove every Co-Authored-By, Signed-off-by and Generated-by line"
fi
if printf '%s\n' "$body" | grep -Eiq 'generated (with|by)'; then
  fail "'generated with/by' line found" "remove it; commits carry no attribution"
fi
if printf '%s\n' "$body" | LC_ALL=C grep -q '[^ -~[:space:]]'; then
  fail "non-ASCII character found (emoji or smart punctuation)" "use plain ASCII"
fi
if [ "${#subject}" -gt 72 ]; then
  fail "subject is ${#subject} characters" "shorten the first line to 72 or fewer"
fi
if ! printf '%s' "$subject" | grep -q '^[A-Z]'; then
  fail "subject does not start with a capital letter" "capitalize the first word"
fi
if [ "$(git config user.name)" != "Zair Naqvi" ]; then
  fail "user.name is '$(git config user.name)'" "git config user.name 'Zair Naqvi'"
fi
banned="${HOME}/.harness/banned-words"
if [ -s "$banned" ] && printf '%s\n' "$body" | grep -Eiqf "$banned"; then
  fail "banned word found (see $banned)" "remove the name; this repository names no employer or client"
fi
exit 0
